# Source on every worker of a two-host, eight-GPUs-per-host TP16 replica.
# Set host/rank discovery, checkpoint and P/D endpoints separately.
# This enables the first-stage reference path; it does not launch a service.
export TP_SIZE=16
export DP_SIZE=1
export EP_SIZE=16
export WORLD_SIZE=16
export LOCAL_WORLD_SIZE=8
export KIMI_K3_ATTENTION_QUANTIZATION=fp8_per_block
export KIMI_K3_FP8_COLLECTIVE_GEMM=0
export KIMI_K3_GEMM_REDUCE_SCATTER_BACKEND=nccl
export KIMI_K3_MLA_FP8=0
export LOAD_METHOD=fastsafetensors
